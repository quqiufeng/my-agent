{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "instructions": ["TOOLS.md", "CAPABILITIES.md", "automation.md"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222", "--no-usage-statistics"],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "read": "deny",
    "edit": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "deny",
      "tools/*": "allow",
      "./tools/*": "allow",
      "bash tools/*": "allow",
      "/opt/my-agent/operator/tools/*": "allow"
    }
  }
}
